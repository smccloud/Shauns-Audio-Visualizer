// Jenkins CI for the .NET 10 ShaunsAudioVisualizer solution on Linux.
//
// Agent: pinned to 'Built-In Node'. Builds and tests the cross-platform subset
// of the solution (ShaunsAudioVisualizer.Linux.slnf), which excludes the
// Windows-only installer and Windows test project.
//
// Prerequisites
//   * A .NET 10 SDK on PATH.
//
// This pipeline does NOT build the Windows installer or the WinForms GUI; those
// remain Windows-only. It validates that the console renderer and all pure
// analysis/conversion code stay green on Linux.

pipeline {
    // Run on the Jenkins built-in (controller) node. Support both modern
    // ('built-in') and legacy ('master') labels for the built-in node.
    agent { label 'built-in || master' }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    environment {
        CONFIGURATION              = 'Release'
        DOTNET_CLI_TELEMETRY_OPTOUT = '1'
        DOTNET_NOLOGO              = '1'
        DOTNET_SKIP_FIRST_TIME_EXPERIENCE = '1'
        SOLUTION                   = 'ShaunsAudioVisualizer.Linux.slnf'
    }

    stages {
        stage('Clean workspace') {
            steps {
                cleanWs(deleteDirs: true, disableDeferredWipeout: true)
                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify SDK') {
            steps {
                sh 'dotnet --version'
                sh 'dotnet --info'
            }
        }

        stage('Restore') {
            steps {
                sh "dotnet restore ${SOLUTION}"
            }
        }

        stage('Build') {
            steps {
                sh "dotnet build ${SOLUTION} --configuration ${CONFIGURATION} --no-restore --warnaserror"
            }
        }

        stage('Test') {
            steps {
                sh "dotnet test ${SOLUTION} --configuration ${CONFIGURATION} --no-build --logger trx --results-directory TestResults"
            }
            post {
                always {
                    script {
                        def trxFound = sh(
                            script: 'ls TestResults/*.trx 2>/dev/null',
                            returnStatus: true
                        ) == 0
                        if (trxFound) {
                            mstest testResultsFile: 'TestResults/*.trx', keepLongStdio: true
                        }
                    }
                }
            }
        }

        stage('Publish (linux-x64)') {
            steps {
                sh 'rm -rf publish dist'
                sh "dotnet publish ShaunsAudioVisualizer/ShaunsAudioVisualizer.csproj --configuration ${CONFIGURATION} --framework net10.0 --runtime linux-x64 --self-contained false /p:PublishSingleFile=true --output publish"
                sh 'ls publish'

                // Build the AppImage (requires appimagetool on PATH).
                sh '''
                    if ! command -v appimagetool >/dev/null 2>&1; then
                        wget -q https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-x86_64.AppImage -O appimagetool
                        chmod +x appimagetool
                    fi
                    export PATH="$PWD:$PATH"
                    packaging/appimage/build-appimage.sh
                    ls dist
                '''
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'publish/**,dist/**', fingerprint: true
        }
        always {
            echo "Build ${env.BUILD_NUMBER} finished: ${currentBuild.currentResult}"
        }
    }
}