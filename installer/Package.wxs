<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Id="ShaunMcCloud.ShaunsAudioVisualizer"
      Name="Audio Visualizer"
      Manufacturer="Shaun McCloud"
      Version="1.0.0"
      UpgradeCode="B8C8D1F6-26DB-4EE4-AC54-907294B7C911"
      Scope="perMachine"
      Language="1033"
      Codepage="65001">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPCONTACT" Value="Shaun McCloud" />
    <Property Id="ARPCOMMENTS" Value="A retro audio visualizer for Windows." />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Icon Id="AppIcon" SourceFile="..\ShaunsAudioVisualizer\app-icon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Audio Visualizer" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Audio Visualizer" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="ShaunsAudioVisualizerExe" Source="ShaunsAudioVisualizer.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="StartMenuShortcut"
                Name="Audio Visualizer"
                Description="A retro audio visualizer for Windows"
                Target="[INSTALLFOLDER]ShaunsAudioVisualizer.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\ShaunMcCloud\ShaunsAudioVisualizer"
                     Name="Installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Feature Id="ProductFeature" Title="Audio Visualizer" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
  </Package>

</Wix>
